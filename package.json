{
  "name": "magicaltouch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && next build || (echo 'Build failed (often Google Fonts not answering); retrying in 20 s' && sleep 20 && next build) || (echo 'Retrying once more in 40 s' && sleep 40 && next build)",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cf": "for i in 1 2 3; do opennextjs-cloudflare deploy --cacheChunkSize 10 && exit 0; echo \"Deploy attempt $i failed; retrying in 20 s\"; sleep 20; done; exit 1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "canvas": "file:./stubs/canvas",
    "fabric": "^5.3.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.400.0",
    "next": "14.2.35",
    "nodemailer": "^6.9.14",
    "opentype.js": "^1.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "polygon-clipping": "^0.15.7",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.7",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "@opennextjs/cloudflare": "1.15.1",
    "wrangler": "^4.59.2"
  }
}
